# Frontend environment — copy to .env. Browser-safe values only.
# NEVER put AI84_API_KEY or a Supabase secret/service key in this file.
VITE_API_BASE_URL=http://localhost:3001
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional: turns "Contact the administrator" on the login page into an email link.
VITE_ADMIN_CONTACT_EMAIL=
